# Production Site Domain (for canonical URLs, sitemap, og:url, metadata)
NEXT_PUBLIC_SITE_URL=https://zeenox-agency.vercel.app

# Lead Capture Webhook (n8n, Google Sheets, Make, or CRM webhook endpoint)
LEAD_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/zeenox-leads

# Resend API for Lead Email Alerts (optional)
RESEND_API_KEY=re_1234567890
LEAD_NOTIFY_EMAIL=hello@zeenox.agency

# Direct Strategy Call Booking Link (Calendly or Cal.com URL; defaults to WhatsApp if empty)
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/zeenox/discovery

# Analytics & Attribution (loaded conditionally only if IDs are provided)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
NEXT_PUBLIC_CLARITY_ID=abcdefghij

# Cloudinary Media Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dtjnm2nc8
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=zeenox_preset
